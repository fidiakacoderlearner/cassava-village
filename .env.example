# Salin file ini menjadi .env lalu isi nilainya (JANGAN commit .env)
# Server dev/start membaca file .env ini via `node --env-file=../.env`.

# Wajib: koneksi PostgreSQL (Neon pooled connection string)
# Sertakan ?sslmode=verify-full (menghilangkan peringatan SSL pg v8.23+).
DATABASE_URL=postgresql://user:password@host/database

# WAJIB di production (Vercel): server gagal start bila kosong.
# Opsional di lokal: tanpa ini server memakai fallback dev.
JWT_SECRET=
